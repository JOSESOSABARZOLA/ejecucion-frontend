# Frontend Environment Variables Template
# For production builds, set these before docker build
#
# REGLA DURA: NINGUNA variable VITE_* puede contener secretos (claves, contrasenas, tokens).
# Todo lo que empiece por VITE_ queda EMBEBIDO EN EL BUNDLE PUBLICO y es legible por cualquiera que
# abra el JavaScript de la aplicacion. Aqui solo caben URLs publicas y el codigo de modulo.
#
# Orden de resolucion en src/config/env.ts (runtime-first, Fase 03.11 / Plan 03):
#   window.__APP_CONFIG__  >  variables VITE_*  >  default por modo
# El runtime va primero para que un MISMO bundle pueda servir a varios ambientes sin recompilar.

# --- API del modulo de Ejecucion ---
# URL base del backend de Ejecucion. En desarrollo, http://localhost:3004
VITE_API_URL=http://app:3000

# Alias historico de VITE_API_URL. Se sigue aceptando por compatibilidad; en despliegues nuevos
# use VITE_API_URL. Si ambas estan puestas, gana VITE_API_URL.
VITE_API_BASE_URL=http://app:3000

# --- AUTH CENTRAL (Fase 03.11) ---
# URL del portal de Auth central al que se redirige a un usuario sin sesion. El frontend le anade
# ?redirectUri=<origen>/auth/callback&module=<VITE_AUTH_MODULE_CODE>
VITE_AUTH_PORTAL_URL=http://172.20.136.127:10006/login

# URL de cierre de sesion de Auth central.
VITE_AUTH_LOGOUT_URL=http://172.20.136.127:10006/login

# Codigo con el que Auth central identifica a este modulo. [ASSUMED Q-01] pendiente de confirmacion
# del equipo de Auth central (checkpoint del Plan 08).
VITE_AUTH_MODULE_CODE=EJECUCION

# Environment
NODE_ENV=production
